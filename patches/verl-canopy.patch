+def rebuild_router_replay_registry(model_chunks, expected_layer_numbers=None):
+    """Bind the process-global replay registry to routers in the final live model tree.
+
+    Some model providers construct a temporary decoder and replace it later.  The
+    constructor-time registry then contains replay controllers for orphaned routers
+    that never participate in forward.  Rebuilding from the final module tree keeps
+    the existing router/controller objects while dropping those stale entries.
+
+    Args:
+        model_chunks: A module or an ordered sequence of pipeline/VPP model chunks.
+        expected_layer_numbers: Optional expected one-based MoE layer numbers for
+            each pipeline/VPP chunk.
+
+    Returns:
+        A dictionary with raw, active, per-chunk counts, and active layer numbers.
+
+    Raises:
+        RuntimeError: If the live tree is malformed or does not match the expected
+            pipeline/VPP-local MoE layout.
+    """
+    if isinstance(model_chunks, torch.nn.Module):
+        chunks = [model_chunks]
+    else:
+        try:
+            chunks = list(model_chunks)
+        except TypeError as exc:
+            raise RuntimeError("Router Replay model_chunks must be a module or an iterable of modules.") from exc
+
+    if not chunks:
+        raise RuntimeError("Router Replay cannot bind an empty model chunk list.")
+
+    if expected_layer_numbers is not None:
+        expected_layer_numbers = [list(layer_numbers) for layer_numbers in expected_layer_numbers]
+        if len(expected_layer_numbers) != len(chunks):
+            raise RuntimeError(
+                "Router Replay expected-layer layout does not match model chunks: "
+                f"expected_layers={expected_layer_numbers}, chunks={len(chunks)}."
+            )
+
+    raw_count = len(RouterReplay.router_instances)
+    active_replays = []
+    active_layer_numbers = []
+    chunk_counts = []
+    seen_router_ids = set()
+    replay_owners = {}
+
+    for chunk_idx, chunk in enumerate(chunks):
+        if not isinstance(chunk, torch.nn.Module):
+            raise RuntimeError(
+                f"Router Replay chunk {chunk_idx} is not a torch.nn.Module: {type(chunk).__name__}."
+            )
+
+        chunk_entries = []
+        for module_name, module in chunk.named_modules():
+            if not isinstance(module, TopKRouter) or getattr(module, "is_mtp_layer", False):
+                continue
+
+            router_id = id(module)
+            if router_id in seen_router_ids:
+                continue
+            seen_router_ids.add(router_id)
+
+            replay = getattr(module, "router_replay", None)
+            if not isinstance(replay, RouterReplay):
+                raise RuntimeError(
+                    "A live TopKRouter has no Verl RouterReplay controller: "
+                    f"chunk={chunk_idx}, module={module_name}, controller={type(replay).__name__}."
+                )
+
+            owner = replay_owners.get(id(replay))
+            if owner is not None:
+                raise RuntimeError(
+                    "Two live TopKRouter modules share one RouterReplay controller: "
+                    f"first={owner}, second=chunk{chunk_idx}:{module_name}."
+                )
+            replay_owners[id(replay)] = f"chunk{chunk_idx}:{module_name}"
+
+            layer_number = getattr(module, "layer_number", None)
+            if layer_number is None:
+                raise RuntimeError(
+                    "A live TopKRouter has no layer_number, so replay order is ambiguous: "
+                    f"chunk={chunk_idx}, module={module_name}."
+                )
+            chunk_entries.append((int(layer_number), module_name, replay))
+
+        chunk_entries.sort(key=lambda entry: entry[0])
+        layer_numbers = [entry[0] for entry in chunk_entries]
+        if len(layer_numbers) != len(set(layer_numbers)):
+            raise RuntimeError(
+                f"Router Replay found duplicate layer numbers in chunk {chunk_idx}: {layer_numbers}."
+            )
+
+        actual_count = len(chunk_entries)
+        if expected_layer_numbers is not None and layer_numbers != expected_layer_numbers[chunk_idx]:
+            raise RuntimeError(
+                "Router Replay live-layer layout mismatch: "
+                f"chunk={chunk_idx}, active={actual_count}, actual_layers={layer_numbers}, "
+                f"expected_layers={expected_layer_numbers[chunk_idx]}, raw_registry={raw_count}."
+            )
+
+        chunk_counts.append(actual_count)
+        active_layer_numbers.append(layer_numbers)
+        active_replays.extend(entry[2] for entry in chunk_entries)
+
+    if not active_replays:
+        raise RuntimeError(
+            f"Router Replay is enabled but the final model tree contains no live TopKRouter (raw={raw_count})."
+        )
+
+    for replay in active_replays:
+        replay.clear_indices()
+        replay.clear_router_replay_action()
+
+    # Replace in place so any compatibility references to this list remain valid.
+    RouterReplay.router_instances[:] = active_replays
+    return {
+        "raw_count": raw_count,
+        "active_count": len(active_replays),
+        "chunk_counts": chunk_counts,
+        "layer_numbers": active_layer_numbers,
+    }
+
